{
  "version": 1,
  "sdk_version": "0.25.0",
  "path": "/functions/v1/mcp",
  "auth": {
    "type": "oauth",
    "issuer": "https://mehouzpbqyfsbuwprtzi.supabase.co/auth/v1",
    "accepted_audiences": [
      "authenticated"
    ]
  },
  "mcp": {
    "server": {
      "name": "trenches-records-mcp",
      "version": "0.1.0",
      "title": "Trenches Records"
    },
    "tools": [
      {
        "name": "list_bookings",
        "title": "List bookings",
        "description": "List Trenches Records studio bookings. Filter by studio, status, and date range. Returns up to `limit` rows ordered by date ascending.",
        "annotations": {
          "readOnlyHint": true,
          "openWorldHint": false
        },
        "inputSchema": {
          "$schema": "http://json-schema.org/draft-07/schema#",
          "type": "object",
          "properties": {
            "studio": {
              "anyOf": [
                {
                  "type": "string",
                  "enum": [
                    "piccolo",
                    "ssg",
                    "videomaker"
                  ]
                },
                {
                  "type": "null"
                }
              ],
              "description": "Filter by studio/resource."
            },
            "status": {
              "anyOf": [
                {
                  "type": "string",
                  "enum": [
                    "pending",
                    "confirmed",
                    "cancelled"
                  ]
                },
                {
                  "type": "null"
                }
              ],
              "description": "Filter by booking status."
            },
            "from_date": {
              "anyOf": [
                {
                  "type": "string"
                },
                {
                  "type": "null"
                }
              ],
              "description": "Inclusive start date YYYY-MM-DD."
            },
            "to_date": {
              "anyOf": [
                {
                  "type": "string"
                },
                {
                  "type": "null"
                }
              ],
              "description": "Inclusive end date YYYY-MM-DD."
            },
            "limit": {
              "anyOf": [
                {
                  "type": "integer",
                  "minimum": 1,
                  "maximum": 200
                },
                {
                  "type": "null"
                }
              ],
              "description": "Max rows to return (default 50)."
            }
          },
          "required": [
            "studio",
            "status",
            "from_date",
            "to_date",
            "limit"
          ]
        },
        "outputSchema": null
      },
      {
        "name": "get_booking",
        "title": "Get booking",
        "description": "Fetch a single booking by id with full details.",
        "annotations": {
          "readOnlyHint": true,
          "openWorldHint": false
        },
        "inputSchema": {
          "$schema": "http://json-schema.org/draft-07/schema#",
          "type": "object",
          "properties": {
            "booking_id": {
              "type": "string",
              "format": "uuid",
              "pattern": "^([0-9a-fA-F]{8}-[0-9a-fA-F]{4}-[1-8][0-9a-fA-F]{3}-[89abAB][0-9a-fA-F]{3}-[0-9a-fA-F]{12}|00000000-0000-0000-0000-000000000000|ffffffff-ffff-ffff-ffff-ffffffffffff)$",
              "description": "Booking UUID."
            }
          },
          "required": [
            "booking_id"
          ]
        },
        "outputSchema": null
      },
      {
        "name": "list_studio_blocks",
        "title": "List studio blocks",
        "description": "List admin-created unavailability blocks (holidays, maintenance, etc.) per studio.",
        "annotations": {
          "readOnlyHint": true,
          "openWorldHint": false
        },
        "inputSchema": {
          "$schema": "http://json-schema.org/draft-07/schema#",
          "type": "object",
          "properties": {
            "studio": {
              "anyOf": [
                {
                  "type": "string",
                  "enum": [
                    "piccolo",
                    "ssg",
                    "videomaker"
                  ]
                },
                {
                  "type": "null"
                }
              ],
              "description": "Filter by studio/resource."
            }
          },
          "required": [
            "studio"
          ]
        },
        "outputSchema": null
      }
    ]
  }
}
